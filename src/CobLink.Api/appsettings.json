{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "CobLink": "Server=localhost,1433;Database=CobLink;Integrated Security=true;TrustServerCertificate=true;Application Name=COBLink.Api"
  },
  "Authentication": {
    "Mode": "Windows",
    "DevelopmentUser": ""
  },
  "Database": {
    "AutoDeploy": false,
    "SeedSampleData": false
  },
  "Takeback": {
    "HighValueThreshold": 25000,
    "ResponseWindowDays": 30
  }
}
